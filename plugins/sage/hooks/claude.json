{
  "description": "sage (Claude Code only): sage mode by phrase, its gates, and the caps on sage agents running at once: one per project and a total.",
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "Edit|Write|MultiEdit|NotebookEdit|Agent|Task|TaskStop|Bash|Monitor|PowerShell|mcp__terminal__.*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }],
    "PostToolUseFailure": [{ "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/launcher.mjs\" sage-hook.mjs", "timeout": 10 }] }]
  }
}
